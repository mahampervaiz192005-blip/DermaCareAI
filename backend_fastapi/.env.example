# FastAPI server
PORT=8000
ENVIRONMENT=development
CLIENT_ORIGIN=http://localhost:5173

# Use the SAME MySQL database credentials from your existing backend/.env
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=dermacare_db

# Use a NEW random secret (at least 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
